# ── Жишээ орчны тохиргоо ──
# Энэ файлыг .env болгож хуулж, утгуудыг солино уу.

# SQLite өгөгдлийн сангийн зам (prisma/schema.prisma-аас харьцангуй)
# Үйлдвэрлэлд абсолют зам ашиглана: file:/app/db/custom.db
DATABASE_URL="file:../db/custom.db"

# /admin панелд нэвтрэх нууц үг — ЗААВАЛ хүчтэй утга тавина
ADMIN_PASSWORD="change-me-strong-password"

# Сесс токеныг гарын үсэглэх нууц түлхүүр — 32+ санамсаргүй тэмдэгт
# Жишээ үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="change-me-random-64-hex"

# ── Production / Netlify — Turso (libSQL) cloud DB ──
# Netlify Functions-ийн файлын систем түр зуурын тул SQLite файл
# хадгалагдахгүй. Turso дээр DB үүсгээд URL + token-оо энд (болон
# Netlify-ийн Environment variables хэсэгт) нэмнэ.
# DB үүсгэх: https://app.turso.tech  →  Create Database
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
